{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jobnovice/heritage-short/schema/storyboard.schema.json",
  "title": "Heritage Short storyboard",
  "description": "The single contract between every pipeline stage. Every stage reads this file; no prompt, seed or line of narration lives in code.",
  "type": "object",
  "required": ["version", "title", "language", "audience", "intent", "style", "characters", "voice", "music", "shots"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "title": {
      "type": "object",
      "required": ["am", "en"],
      "properties": {"am": {"type": "string"}, "en": {"type": "string"}},
      "additionalProperties": false
    },
    "logline": {"type": "string"},
    "language": {"type": "string", "description": "BCP-47 code of the narration language", "examples": ["am"]},
    "audience": {"type": "string", "minLength": 10},
    "intent": {"type": "string", "minLength": 10},
    "target_duration_sec": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2, "default": [60, 90]},
    "style": {
      "type": "object",
      "required": ["block", "negative"],
      "additionalProperties": false,
      "properties": {
        "block": {"type": "string", "description": "Style block appended to every keyframe prompt"},
        "negative": {"type": "string"},
        "keyframe_provider": {"enum": ["cloudflare", "pollinations", "placeholder"], "default": "cloudflare"},
        "keyframe_model": {"type": "string", "default": "@cf/black-forest-labs/flux-1-schnell"},
        "keyframe_size": {"type": "integer", "minimum": 512, "maximum": 2048, "default": 1024}
      }
    },
    "characters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["description", "seed"],
        "additionalProperties": false,
        "properties": {
          "description": {"type": "string", "description": "Fixed description pasted into every prompt that features this character"},
          "seed": {"type": "integer"},
          "real_person": {"type": "boolean", "description": "true if this depicts a real person; requires a consent entry in ETHICS.md"},
          "consent_ref": {"type": "string"}
        }
      }
    },
    "voice": {
      "type": "object",
      "required": ["provider", "voice_name", "style_instruction"],
      "additionalProperties": false,
      "properties": {
        "provider": {"enum": ["gemini", "addis", "silent"]},
        "model": {"type": "string"},
        "voice_name": {"type": "string"},
        "style_instruction": {"type": "string"},
        "lead_in_sec": {"type": "number", "minimum": 0, "default": 0.4},
        "tail_sec": {"type": "number", "minimum": 0, "default": 0.6}
      }
    },
    "music": {
      "type": "object",
      "required": ["provider", "cues"],
      "additionalProperties": false,
      "properties": {
        "provider": {"enum": ["qenet", "acestep", "file"]},
        "chosen_candidate": {"type": "string", "description": "Path of the chosen score when provider is acestep/file"},
        "seed": {"type": "integer", "default": 7},
        "tempo_bpm": {"type": "number", "minimum": 30, "maximum": 160},
        "root_hz": {"type": "number"},
        "caption": {"type": "string", "description": "ACE-Step caption (style, mood, instruments, texture)"},
        "cues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "starts_at_shot", "mode", "intensity", "purpose"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string"},
              "starts_at_shot": {"type": "string"},
              "mode": {"enum": ["tizita_major", "tizita_minor", "bati_major", "bati_minor", "ambassel", "anchihoye", "silence"]},
              "intensity": {"type": "number", "minimum": 0, "maximum": 1},
              "purpose": {"type": "string"}
            }
          }
        },
        "duck": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "threshold": {"type": "number", "default": 0.02},
            "ratio": {"type": "number", "default": 6},
            "attack_ms": {"type": "number", "default": 300},
            "release_ms": {"type": "number", "default": 1500}
          }
        }
      }
    },
    "end_card": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration_sec": {"type": "number", "minimum": 2, "maximum": 6, "default": 3.5},
        "lines_am": {"type": "array", "items": {"type": "string"}},
        "lines_en": {"type": "array", "items": {"type": "string"}}
      }
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["id", "beat", "reason", "shot_size", "duration_sec", "characters", "image_prompt", "motion", "narration"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^s[0-9]{2}$"},
          "beat": {"type": "string", "description": "Story beat / chapter this shot belongs to"},
          "reason": {"type": "string", "minLength": 10, "description": "Why this shot exists, in one sentence"},
          "shot_size": {"enum": ["extreme_wide", "wide", "medium", "medium_close", "close", "extreme_close", "insert"]},
          "duration_sec": {"type": "number", "minimum": 2, "maximum": 14, "description": "Minimum on-screen time; the real duration is max(this, narration length + lead-in + tail)"},
          "characters": {"type": "array", "items": {"type": "string"}},
          "image_prompt": {"type": "string", "minLength": 10},
          "seed": {"type": "integer"},
          "reference": {"type": "string", "description": "Path of a reference image (character sheet) this shot is checked against"},
          "motion": {
            "type": "object",
            "required": ["camera"],
            "additionalProperties": false,
            "properties": {
              "camera": {"enum": ["push_in", "pull_out", "pan_left", "pan_right", "tilt_up", "tilt_down", "static"]},
              "video_prompt": {"type": "string", "description": "Motion-only prompt for Wan 2.2 image-to-video"},
              "use_video": {"type": "boolean", "default": false, "description": "Prefer a Wan 2.2 clip from outputs/clips/ over Ken Burns"}
            }
          },
          "narration": {
            "type": "object",
            "required": ["am", "en"],
            "additionalProperties": false,
            "properties": {
              "am": {"type": "string", "description": "Narration line in Amharic (spoken)"},
              "en": {"type": "string", "description": "English subtitle"},
              "translit": {"type": "string", "description": "Romanised Amharic for reviewers who do not read Ge'ez script"}
            }
          },
          "sfx": {"type": "string", "description": "Optional ambience note"}
        }
      }
    }
  }
}
