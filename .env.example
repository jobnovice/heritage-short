# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# Optional: model ids (discover with `make smoke`, which lists the models your key can use)
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Optional keyframe provider (free, no card): https://dash.cloudflare.com -> Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional: Addis AI (Amharic TTS comparison)
ADDIS_AI_API_KEY=
